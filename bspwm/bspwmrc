#!/bin/bash

# =====================================================
#                    BSPWM КОНФИГ
# =====================================================

# --- Прозрачность (нужен picom) ---
picom --config ~/.config/bspwm/picom.conf &

# --- Разделители окон и отступы ---
bspc config border_width         2
bspc config window_gap           8
bspc config top_padding          45      # под бар
bspc config bottom_padding       5
bspc config left_padding         5
bspc config right_padding        5

# --- Цвета рамок (разделители) ---
bspc config focused_border_color  "#BD93F9"
bspc config normal_border_color   "#44475A"
bspc config presel_feedback_color "#FFB86C"

# --- Поведение ---
bspc config focus_follows_pointer true
bspc config pointer_follows_focus true
bspc config ignore_ewmh_focus    false

# --- Правила для окон (прозрачные и плавающие) ---
# Все окна будут полупрозрачными (управляется picom)
bspc rule -a "*" state=tiled

# --- Рабочие столы (10 штук, можно меньше) ---
bspc monitor -d "Ⅰ" "Ⅱ" "Ⅲ" "Ⅳ" "Ⅴ" "Ⅵ" "Ⅶ" "Ⅷ" "Ⅸ" "Ⅹ"

# --- Запуск бара ---
~/.config/polybar/launch.sh &

# --- Горячие клавиши (sxhkd) ---
sxhkd &
